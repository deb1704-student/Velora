{
  "name": "velora-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Velora — Advanced Salon Service Management & Marketplace Platform",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "db:generate": "pnpm --filter @velora/database db:generate",
    "db:push": "pnpm --filter @velora/database db:push",
    "db:migrate": "pnpm --filter @velora/database db:migrate",
    "db:studio": "pnpm --filter @velora/database db:studio",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
