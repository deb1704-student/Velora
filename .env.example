# ==========================================
# VELORA ENVIRONMENT CONFIGURATION (SAMPLE)
# ==========================================

# Node & App Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://velora_user:velora_secure_dev_password@localhost:5432/velora_db?schema=public"

# Redis Cache & Queues (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_for_development_min_32_chars_long
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=super_secret_refresh_token_dev_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=30d

# Web App URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Financial & Payments
PAYMENT_GATEWAY_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Email & Notifications (SMTP / Mock for dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="no-reply@velora.com"
